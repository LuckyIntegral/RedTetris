# Copy to .env next to compose.yml on the server, then: chmod 600 .env
# Wrap a value in single quotes if it contains $ or spaces.

# Public hostname. Caddy obtains its TLS certificate automatically, and the
# VITE_SERVER_URL repository variable must be https://<DOMAIN>.
DOMAIN=tetris.example.com

DB_USER=app
DB_NAME=red_tetris

# Generate each of these with: openssl rand -hex 32  (JWT_SECRET: openssl rand -hex 64)
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

JWT_EXPIRES_IN=7d

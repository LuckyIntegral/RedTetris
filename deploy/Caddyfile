# Terminates TLS (certificates are obtained and renewed automatically) and routes by path.
# /api-docs and /health are not routed, so they stay reachable only inside the Docker network.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Limits where injected code could send data (the auth token lives in localStorage).
		# 'unsafe-inline' scripts are needed for React Router's server-rendered hydration scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss://{$DOMAIN} https://*.sentry.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-X-Powered-By
	}

	handle /api/* {
		reverse_proxy server:3002
	}

	handle /socket.io/* {
		reverse_proxy server:3002
	}

	handle {
		reverse_proxy client:3001
	}
}

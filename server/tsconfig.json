{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "*.ts",
    "utils/**/*.ts",
    "models/**/*.ts",
    "middleware/**/*.ts",
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "config/**/*.ts",
    "core/**/*.ts",
    "game/**/*.ts",
    "net/**/*.ts",
    "types/**/*.ts",
    "constants/**/*.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
